#!/usr/bin/env bash

# Regex patterns for secrets
PATTERNS=(
  "[0-9]{9,10}:[a-zA-Z0-9_-]{35}" # Telegram Bot Token
  "hf_[a-zA-Z0-9]{34}"            # Hugging Face Token
  "GOCSPX-[a-zA-Z0-9_-]{28}"      # Google OAuth Client Secret
  "UPSTASH_REDIS_REST_TOKEN=[\"']?[A-Za-z0-9_-]{20,}"   # Upstash Redis Token
)

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  # Initial commit: diff against an empty tree object
  against=$(git hash-object -t tree /dev/null)
fi

# Get staged files
FILES=$(git diff --cached --name-only --diff-filter=ACM $against)

if [ -z "$FILES" ]; then
  exit 0
fi

# Check for garbage files (logs and root throwaway scripts)
for FILE in $FILES; do
  if [[ "$FILE" == *.log ]]; then
    echo "❌ ERROR: Committing log files (*.log) is blocked!"
    echo "File: $FILE"
    echo "Please add it to .gitignore or remove it."
    exit 1
  fi
  # Prevent .py and .js files in the root dir from being committed
  if [[ "$FILE" == *.py ]] || [[ "$FILE" == *.js ]]; then
    # if there is no slash in the file path, it's in the root dir
    if [[ "$FILE" != */* ]]; then
      echo "❌ ERROR: Committing Python/JS scripts to the root directory is blocked to keep it clean!"
      echo "File: $FILE"
      echo "Please move it to scripts/playground/ or another appropriate directory."
      exit 1
    fi
  fi
done

for PATTERN in "${PATTERNS[@]}"; do
  # Use grep on the diff of staged files
  MATCHES=$(git diff --cached --color=never $against -- $FILES | grep -E "^\+" | grep -E "$PATTERN")
  
  if [ ! -z "$MATCHES" ]; then
    echo "❌ ERROR: Potential secret detected in your staged changes!"
    echo "Pattern matched: $PATTERN"
    echo "Please remove the secret or use environment variables before committing."
    exit 1
  fi
done

# Check for timezone safety
TS_FILES=$(echo "$FILES" | grep -E "\.(ts|tsx|js|jsx)$")
if [ ! -z "$TS_FILES" ]; then
  # Find lines added containing toLocaleDateString or toLocaleTimeString
  BAD_DATES=$(git diff --cached --color=never $against -- $TS_FILES | grep -E "^\+" | grep -E "toLocaleDateString|toLocaleTimeString" | grep -v "Asia/Jakarta")
  
  if [ ! -z "$BAD_DATES" ]; then
    echo "❌ ERROR: Unsafe Date formatting detected!"
    echo "You used toLocaleDateString or toLocaleTimeString without specifying the 'Asia/Jakarta' timezone."
    echo "Matches:"
    echo "$BAD_DATES"
    echo "Please add { timeZone: 'Asia/Jakarta' } to your format options to prevent UTC offset bugs."
    exit 1
  fi
fi

# Run Ruff on apps/api if Python files changed
PYTHON_FILES=$(echo "$FILES" | grep -E "\.py$")
if [ ! -z "$PYTHON_FILES" ] && [ -d "apps/api" ]; then
  echo "🔍 Running Ruff checks on apps/api..."
  (cd apps/api && ruff check . && ruff format --check .)
  if [ $? -ne 0 ]; then
    echo "❌ ERROR: Ruff linting or formatting failed!"
    echo "Please run 'cd apps/api && ruff check --fix . && ruff format .' to fix the issues."
    exit 1
  fi
fi

exit 0
